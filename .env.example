# Server
PORT=3000
NODE_ENV=development

# Internal API authentication.
# Production must set a long random secret. Development falls back to dev-internal-api-key if unset.
INTERNAL_API_KEY=dev-internal-api-key

# AI provider: "mock" (no external calls), "gemini", or "openrouter"
AI_PROVIDER=mock

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# CORS: browser origins allowed to call this API.
# Supports comma-separated origins. In production set this to your Vercel frontend URL.
# CORS is not a replacement for internal API authentication.
CORS_ORIGIN=http://localhost:5173

# Shared fallback rate limiting values (per IP).
# RATE_LIMIT_MAX    — max requests per window (default: 60)
# RATE_LIMIT_WINDOW — window in milliseconds  (default: 60000 = 1 minute)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# Endpoint-specific rate limits for expensive protected routes (per IP).
# AI_* defaults to RATE_LIMIT_* when unset. CV parsing defaults to 10 requests/minute.
AI_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW=60000
CV_PARSE_RATE_LIMIT_MAX=10
CV_PARSE_RATE_LIMIT_WINDOW=60000
