# Server
PORT=3000
NODE_ENV=development

# Internal API authentication.
# Production must set a long random secret. Development falls back to dev-internal-api-key if unset.
INTERNAL_API_KEY=dev-internal-api-key

# AI provider: "mock" (no external calls), "gemini", or "openrouter"
AI_PROVIDER=mock

# Required when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Required when AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# CORS: browser origins allowed to call this API.
# In production set this to your Vercel frontend URL.
CORS_ORIGIN=http://localhost:5173

# Rate limiting for /api/ai/* routes (per IP).
# RATE_LIMIT_MAX    — max requests per window (default: 60)
# RATE_LIMIT_WINDOW — window in milliseconds  (default: 60000 = 1 minute)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000
